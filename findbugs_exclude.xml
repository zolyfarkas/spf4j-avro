<?xml version="1.0" encoding="UTF-8"?>

<!--
  Vendored 2026-11-05 from spf4j (findbugs_exclude.xml, spf4j 8.10.1-SNAPSHOT)
  so this library enforces the same SpotBugs setup as spf4j (line endings
  normalized CRLF -> LF; Match entries unchanged). The entries from spf4j are
  above the "grandfathered baseline" marker near the end of this file; entries
  below that marker were added for this library and must only shrink.
-->

<FindBugsFilter>

     <Match>
         <!-- PMB_INSTANCE_BASED_THREAD_LOCAL cannot be suppresed with annotation for whatever reason -->
        <!-- CD_CIRCULAR_DEPENDENCY is nuts in fb-contrib 6.6.2 -->
        <!-- CRLF_INJECTION_LOGS this is irelevant, devs need to use good log appenders. -->
        <!-- RFI_SET_ACCESSIBLE ... JDK 10 suposedly will drop this functionality.... will re-enable when moving to JDK 9 -->
        <!-- FII_USE_FUNCTION_IDENTITY has a lot of false positives that are fixed in next fb-contrib -->
        <!-- LO_INCORRECT_NUMBER_OF_ANCHOR_PARAMETERS is a valid use case with my prefered backends -->
        <!-- BAS_BLOATED_ASSIGNMENT_SCOPE complains on valid code, see FailOnTimeout.java:[line 254] for an example -->
       <Bug pattern="BAS_BLOATED_ASSIGNMENT_SCOPE,LO_INCORRECT_NUMBER_OF_ANCHOR_PARAMETERS,FII_USE_FUNCTION_IDENTITY,RFI_SET_ACCESSIBLE,CRLF_INJECTION_LOGS,BL_BURYING_LOGIC,CD_CIRCULAR_DEPENDENCY,EXS_EXCEPTION_SOFTENING_HAS_CHECKED,UVA_USE_VAR_ARGS,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,MOM_MISLEADING_OVERLOAD_MODEL,EXS_EXCEPTION_SOFTENING_NO_CONSTRAINTS,PMB_INSTANCE_BASED_THREAD_LOCAL,OPM_OVERLY_PERMISSIVE_METHOD,IMC_IMMATURE_CLASS_NO_EQUALS" />
     </Match>
  
    <Match>
      <Class name="~.*Test([.].*)?"/>
      <Bug category="SECURITY" />
    </Match>

    <Match>
      <Class name="~.*Test([.].*)?"/>
      <Bug pattern="CE_CLASS_ENVY,EI_EXPOSE_REP2,EI_EXPOSE_REP,SEC_SIDE_EFFECT_CONSTRUCTOR,SIC_INNER_SHOULD_BE_STATIC_ANON,BC_UNCONFIRMED_CAST,PREDICTABLE_RANDOM" />
    </Match>

    <!-- ===== Grandfathered baseline (regenerated 2026-11-05 after the pri-1/pri-2 burn-down) =====
         Entries below this marker are NOT spf4j's. After the 2026-11-05
         burn-down, every SpotBugs instance at priority 1 or 2 and every
         security instance in editable sources is fixed in code or
         suppressed narrowly in code (@SuppressFBWarnings with a reason);
         none of those may reappear here. What remains below is exactly:
         (a) priority 3/4 non-security instances in inherited code,
         (b) exact class+pattern entries for build-generated code, which
         is NOT exempt from analysis (user directive 2026-11-05): every
         priority 1/2 and security instance in generated code is fixed
         at the generator (idl.jj, the seeded JavaCC skeletons under
         compiler/src/main/javacc-skeletons, the SpecificCompiler
         Velocity templates) or suppressed by generator-emitted
         @SuppressFBWarnings; the only entries of this kind are the
         JavaCC token manager and constants interface, which JavaCC
         emits from internal templates with no grammar, template or
         seeding lever, plus priority 3/4 instances in generated
         classes, held to the same standard as (a), and
         (c) SIC_INNER_SHOULD_BE_STATIC_ANON entries keyed by the
         ENCLOSING class: for that finding SpotBugs matches filters
         against the enclosing class, not the anonymous $N class it
         reports, so exact $N entries cannot match.
         This section must only shrink.
         See avro-standalone-static-analysis.md for the disposition table. -->
    <Match>
      <!-- Grammar-generated parser class: the priority 3 patterns of the
           generated productions (production method names are the grammar's
           own). All priority 1/2 and security instances in this class are
           fixed in idl.jj or suppressed by annotations the grammar emits. -->
      <Class name="org.spf4j.avro.compiler.idl.Idl"/>
      <Bug pattern="AI_ANNOTATION_ISSUES_NEEDS_NULLABLE,DLS_DEAD_LOCAL_STORE,IMC_IMMATURE_CLASS_NO_TOSTRING,IMC_IMMATURE_CLASS_WRONG_FIELD_ORDER,NM_METHOD_NAMING_CONVENTION,SEO_SUBOPTIMAL_EXPRESSION_ORDER,UWF_UNWRITTEN_FIELD"/>
    </Match>
    <Match>
      <!-- LAST RESORT (mechanisms 1-2 impossible): the tokenImage array is
           emitted into this constants interface by JavaCC's internal
           template, driven by the grammar's token declarations; the
           array's shape and exposure are fixed by that template, and the
           interface is regenerated unconditionally on every build, so
           neither the grammar nor the skeleton seeding can reach it. -->
      <Class name="org.spf4j.avro.compiler.idl.IdlConstants"/>
      <Bug pattern="MS_OOI_PKGPROTECT"/>
    </Match>
    <Match>
      <!-- LAST RESORT (mechanisms 1-2 impossible): this class is emitted in
           full by JavaCC's internal token-manager templates from the
           grammar's token specifications. It is not one of the skeleton
           files JavaCC creates only when absent, so the seeding mechanism
           cannot reach it, and the grammar offers no hook to annotate or
           reshape it. The priority 1 CC instances are the generated DFA
           tables for this grammar's token set. -->
      <Class name="org.spf4j.avro.compiler.idl.IdlTokenManager"/>
      <Bug pattern="CC_CYCLOMATIC_COMPLEXITY,EI_EXPOSE_REP2,IMC_IMMATURE_CLASS_NO_TOSTRING,IMC_IMMATURE_CLASS_WRONG_FIELD_ORDER,MS_PKGPROTECT,NM_METHOD_NAMING_CONVENTION,PCOA_PARTIALLY_CONSTRUCTED_OBJECT_ACCESS,REC_CATCH_EXCEPTION,SEO_SUBOPTIMAL_EXPRESSION_ORDER,SF_SWITCH_NO_DEFAULT,UCF_USELESS_CONTROL_FLOW,UC_USELESS_VOID_METHOD,URF_UNREAD_FIELD"/>
    </Match>
    <Match>
